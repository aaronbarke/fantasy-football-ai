{
  "manifest_version": 3,
  "name": "FFAI Connect for ESPN",
  "version": "1.0.0",
  "description": "Connect your private ESPN fantasy leagues to Fantasy Football AI in one click. No developer tools, no copying cookies.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies"],
  "host_permissions": ["https://*.espn.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy-football-ai-theta.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "FFAI Connect for ESPN",
    "default_popup": "popup.html"
  }
}
