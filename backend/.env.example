# Database — docker-compose default shown; use sqlite+aiosqlite:///./dev.db for quick local dev
DATABASE_URL=postgresql+asyncpg://fantasy:fantasy@localhost:5432/fantasy

# Redis cache (optional — app degrades gracefully without it)
REDIS_URL=redis://localhost:6379/0

# Auth — at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google sign-in (optional). Your Google OAuth Web Client ID — no secret needed.
# Leave blank to disable "Continue with Google". See docs/SETUP_GOOGLE_OAUTH.md.
GOOGLE_CLIENT_ID=

# External data
ODDS_API_KEY=

# App
CORS_ORIGINS=http://localhost:3000
ENABLE_SCHEDULER=false
CURRENT_SEASON=2026

# "development" or "production". In production a non-default JWT_SECRET is
# required, admin endpoints are locked down and the /docs pages are off.
ENVIRONMENT=development
# Comma-separated emails allowed to hit admin endpoints (e.g. /api/admin/refresh-stats)
ADMIN_EMAILS=

# Reverse proxies in front of the API, for reading the client IP out of
# X-Forwarded-For when rate limiting. Unset = 1 in production, 0 in development.
# TRUSTED_PROXY_COUNT=1

# Fernet key for encrypting stored ESPN cookies. Blank = derived from JWT_SECRET
# (then rotating JWT_SECRET means ESPN private leagues must reconnect). Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Daily Claude-call caps (reset at midnight UTC)
AI_DAILY_LIMIT_PER_USER=100
AI_DAILY_LIMIT_DEMO_PER_IP=20
AI_DAILY_LIMIT_DEMO_TOTAL=300
