NEXT_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (optional). Same Google OAuth Web Client ID as the backend's
# GOOGLE_CLIENT_ID. Leave blank to hide "Continue with Google".
# See docs/SETUP_GOOGLE_OAUTH.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ESPN connect extension (optional). Chrome Web Store address of the published
# "FFAI Connect for ESPN" extension. Leave blank and the Connect page offers
# the bundled copy (public/ffai-espn-connect.zip) with install steps instead.
# See extension/README.md.
NEXT_PUBLIC_ESPN_EXTENSION_URL=

# Optional: a contact address shown on the /privacy page for account-deletion
# requests. Blank points people to the project's GitHub issues instead.
NEXT_PUBLIC_CONTACT_EMAIL=
